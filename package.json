{
  "name": "mail-chat",
  "productName": "Mail Chat",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "keywords": [
    "electron",
    "outlook",
    "microsoft-graph",
    "email",
    "chat",
    "react",
    "typescript"
  ],
  "description": "Your Outlook mail as group chats: every email thread is a group, every email is a message.",
  "main": "out/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/build.mjs --dev && electron .",
    "ui": "vite --config vite.config.mts --port 5181 --strictPort",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "node scripts/build.mjs && electron-builder --win --x64 --publish never",
    "dist:dir": "node scripts/build.mjs && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.3"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.2.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "marked": "^15.0.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  }
}
